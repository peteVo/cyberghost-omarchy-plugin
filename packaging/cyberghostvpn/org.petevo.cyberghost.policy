<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>CyberGhost for Omarchy contributors</vendor>
  <vendor_url>https://github.com/peteVo/cyberghost-omarchy-plugin</vendor_url>
  <icon_name>network-vpn</icon_name>
  <action id="org.petevo.cyberghost.manage">
    <description>Manage CyberGhost VPN connections</description>
    <message>Administrator authentication is required to manage CyberGhost VPN connections and traffic protection</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/cyberghost/omarchy-bridge</annotate>
  </action>
</policyconfig>
